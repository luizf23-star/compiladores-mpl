funcao minutos inteiro (v0_atividades inteiro)
  t0 = v0_atividades
  t1 = 0
  t2 = t0 <= t1
  seFalso t2 desvie L0
  t3 = 0
  retorne t3
L0:
  t4 = 30
  t5 = v0_atividades
  t6 = 1
  t7 = t5 - t6
  t8 = chama minutos t7
  t9 = t4 + t8
  retorne t9
fim
funcao progresso real (v0_concluidas inteiro, v1_total inteiro)
  t0 = v0_concluidas
  t1 = 100.0
  t2 = converte_real t0
  t3 = t2 * t1
  t4 = v1_total
  t5 = converte_real t4
  t6 = t3 / t5
  retorne t6
fim
funcao principal vazio ()
  v0_total = 0
  t0 = 6
  v0_total = t0
  v1_concluidas = 0
  t1 = 2
  v1_concluidas = t1
  v2_porSemana = 0
  t2 = 2
  v2_porSemana = t2
  v3_semana = 0
  t3 = 0
  v3_semana = t3
  t4 = "PLANEJADOR DE ESTUDOS"
  escreva t4
  t5 = "Atividades pendentes:"
  escreva t5
  t6 = v0_total
  t7 = v1_concluidas
  t8 = t6 - t7
  escreva t8
  t9 = "Minutos previstos:"
  escreva t9
  t10 = v0_total
  t11 = v1_concluidas
  t12 = t10 - t11
  t13 = chama minutos t12
  escreva t13
L0:
  t14 = v1_concluidas
  t15 = v0_total
  t16 = t14 < t15
  seFalso t16 desvie L1
  t17 = v3_semana
  t18 = 1
  t19 = t17 + t18
  v3_semana = t19
  t20 = v1_concluidas
  t21 = v2_porSemana
  t22 = t20 + t21
  v1_concluidas = t22
  t23 = v1_concluidas
  t24 = v0_total
  t25 = t23 > t24
  seFalso t25 desvie L2
  t26 = v0_total
  v1_concluidas = t26
L2:
  t27 = "Semana:"
  escreva t27
  t28 = v3_semana
  escreva t28
  t29 = "Progresso:"
  escreva t29
  t30 = v1_concluidas
  t31 = v0_total
  t32 = chama progresso t30, t31
  escreva t32
  desvie L0
L1:
  t33 = "Tudo concluido:"
  escreva t33
  t34 = v1_concluidas
  t35 = v0_total
  t36 = t34 == t35
  escreva t36
  retorne
fim
